// bora_cumpade main() simbora
//     trem_di_numeru t1 uai
//     t1 fica_assim_entao 10 uai

//     trem_di_numeru a, b, c uai
//     a fica_assim_entao 5 uai
//     b fica_assim_entao 2 uai
//     c fica_assim_entao a + b uai

//     oia_proce_ve(t1) uai
// cabo

