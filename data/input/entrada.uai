bora_cumpade main()
simbora
    trem_di_numeru a, b, c uai
    trem_cum_virgula media uai
    trem_discrita nome uai

    a fica_assim_entao 10 uai
    b fica_assim_entao 20 uai
    c fica_assim_entao a + b veiz 2 uai

    media fica_assim_entao a + b sob 2 uai

    oia_proce_ve("Resultado: ", c) uai

    uai_se (a < b) simbora
        oia_proce_ve("a eh menor que b") uai
    cabo uai_senao simbora
        oia_proce_ve("a nao eh menor que b") uai
    cabo

    enquanto_tiver_trem (a < 15) simbora
        a fica_assim_entao a + 1 uai
    cabo

    roda_esse_trem (a fica_assim_entao 0; a < 5; a fica_assim_entao a + 1) simbora
        oia_proce_ve(a) uai
    cabo
cabo

