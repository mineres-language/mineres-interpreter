// // Resultado real: False
// bora_cumpade main() simbora
//     trem_discolhe a, b, c uai
//     a fica_assim_entao eh uai
//     b fica_assim_entao num_eh uai
//     c fica_assim_entao a tamem b uai
//     oia_proce_ve(c) uai
// cabo

