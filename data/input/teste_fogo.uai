// // --- BUG #1: 'sob' int/int retorna float — tipo semântico diz int, runtime guarda float ---
// // _validar_operacao_matematica retorna PR_TREM_DI_NUMERU para sob int/int,
// // mas o interpretador faz v1 / v2 (Python float division).
// // Esperado: 2 (se 'sob' for div inteira) ou 2.5 explicitamente tipado como float
// // Resultado real: 2.5 guardado numa variável de tipo trem_di_numeru
// bora_cumpade main() simbora
//     trem_di_numeru x uai
//     x fica_assim_entao 5 sob 2 uai
//     oia_proce_ve(x) uai
// cabo

// // --- BUG #1b: float contaminado pela 'sob' quebra divisão inteira posterior ---
// // c recebe 2.5 (float) mesmo sendo trem_di_numeru. Depois, 10 / c = 10 // 2.5 = 4.0.
// // Esperado: 4
// // Resultado real: 4.0
// bora_cumpade main() simbora
//     trem_di_numeru a, b, c, d uai
//     a fica_assim_entao 10 uai
//     b fica_assim_entao 4 uai
//     c fica_assim_entao a sob b uai
//     d fica_assim_entao 10 / c uai
//     oia_proce_ve(d) uai
// cabo

