// // (Digite "3.5" quando o programa pedir entrada)
// // Esperado: loop termina com soma dos dígitos correto
// // Resultado real: resultados com vírgula (float), loop pode não terminar se n nunca chegar a 0
// bora_cumpade main() simbora
//     trem_di_numeru n, soma, digito uai
//     xove(trem_di_numeru, n) uai
//     soma fica_assim_entao 0 uai
//     enquanto_tiver_trem (n > 0)
//     simbora
//         digito fica_assim_entao n % 10 uai
//         soma fica_assim_entao soma + digito uai
//         n fica_assim_entao n / 10 uai
//     cabo
//     oia_proce_ve(soma) uai
// cabo


