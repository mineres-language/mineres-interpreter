// // Resultado real: [ERRO SINTÁTICO]
// bora_cumpade main() simbora
//     trem_di_numeru x uai
//     x fica_assim_entao 0XFF uai
//     oia_proce_ve(x) uai
// cabo


// =============================================================================
// SEÇÃO 7: BUGS DE FLUXO — COMPORTAMENTO ERRADO EM BREAK/CONTINUE
// =============================================================================

// // --- BUG #13: toca_o_trem dentro de dependenu que está dentro de while ---
// // dependenu faz pilha_loops.append((L_fim, L_fim)), então toca_o_trem vê
// // o L_fim do switch como alvo, não o L_inicio do while externo.
// // Resultado: toca_o_trem sai do switch, mas NÃO continua o while.
// // Esperado: continuar o laço while (i chegar a 5 e imprimir "fim")
// // Resultado real: sai do switch e sai do while junto (ou entra em loop infinito)
// bora_cumpade main() simbora
//     trem_di_numeru i uai
//     i fica_assim_entao 0 uai
//     enquanto_tiver_trem (i < 5)
//     simbora
//         dependenu(i) simbora
//             du_casu 2:
//                 i fica_assim_entao i + 1 uai
//                 toca_o_trem uai
//         cabo
//         i fica_assim_entao i + 1 uai
//     cabo
//     oia_proce_ve("fim") uai
//     oia_proce_ve(i) uai
// cabo

// // --- BUG #14: para_o_trem dentro de dependenu apenas sai do switch, não do laço ---
// // Mesmo motivo do BUG #13: pilha_loops aponta para L_fim do dependenu.
// // Esperado: para_o_trem quebra o while quando i == 2 (i fica 2, não chega a 5)
// // Resultado real: sai do switch, o while continua normalmente até i = 5
// bora_cumpade main() simbora
//     trem_di_numeru i uai
//     i fica_assim_entao 0 uai
//     enquanto_tiver_trem (i < 5)
//     simbora
//         dependenu(i) simbora
//             du_casu 2: para_o_trem uai
//         cabo
//         i fica_assim_entao i + 1 uai
//     cabo
//     oia_proce_ve(i) uai
// cabo


// =============================================================================
// SEÇÃO 8: COMPORTAMENTOS SURPREENDENTES (não crasham, mas surpreendem)
// =============================================================================

// // --- SURPRESA #1: trem_discolhe inicializa como eh (true), não num_eh (false) ---
// // Em C/Java, bool inicializa como false. No Minerês, o padrão é "eh" (true).
// // Esperado (intuitivo): num_eh
// // Resultado real: eh
// bora_cumpade main() simbora
//     trem_discolhe b uai
//     oia_proce_ve(b) uai
// cabo

// // --- SURPRESA #2: LHS entre parênteses é aceito como atribuição ---
// // O check de LHS verifica cod_esq == [] e @x na tabela. (x) satisfaz ambos.
// // Esperado (parser rigoroso): [ERRO SINTÁTICO]
// // Resultado real: imprime 5 normalmente
// bora_cumpade main() simbora
//     trem_di_numeru x uai
//     (x) fica_assim_entao 5 uai
//     oia_proce_ve(x) uai
// cabo

// // --- SURPRESA #3: comparar strings com '<' é semanticamente válido ---
// // _validar_operacao_relacional aceita mesmo tipo. trem_discrita == trem_discrita → OK.
// // Na prática faz comparação lexicográfica Python, imprimindo True/False.
// // Esperado pelo usuário: [ERRO SEMÂNTICO] (strings não são comparáveis com <)
// // Resultado real: imprime True (comparação lexicográfica funciona, mas printa True)
// bora_cumpade main() simbora
//     trem_discrita a, b uai
//     trem_discolhe r uai
//     a fica_assim_entao "abelha" uai
//     b fica_assim_entao "zebra" uai
//     r fica_assim_entao a < b uai
//     oia_proce_ve(r) uai
// cabo
