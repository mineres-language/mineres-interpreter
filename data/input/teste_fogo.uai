// =============================================================================
// TESTE FOGO - Todos os testes que quebram o programa
//
// Como usar: descomente um bloco por vez, copie para entrada.uai e rode.
// Cada bloco tem: descrição do problema, resultado esperado e resultado real.
// =============================================================================


// =============================================================================
// SEÇÃO 1: ERROS DE EXECUÇÃO (RUNTIME)
// A VM detecta e reporta — mas precisam ser testados para garantir que
// o caminho de erro está correto e a mensagem é legível.
// =============================================================================

// // --- Divisão inteira por zero ---
// // Esperado: [ERRO INTERPRETADOR] Divisão inteira por zero.
// bora_cumpade main() simbora
//     trem_di_numeru dinheiro, pessoas, divisao uai
//     dinheiro fica_assim_entao 100 uai
//     pessoas fica_assim_entao 0 uai
//     divisao fica_assim_entao dinheiro / pessoas uai
//     oia_proce_ve("Isso nunca sera impresso!") uai
// cabo

// // --- Divisão real (sob) por zero ---
// // Esperado: [ERRO INTERPRETADOR] Divisão real por zero.
// bora_cumpade main() simbora
//     trem_cum_virgula a uai
//     a fica_assim_entao 5.0 sob 0.0 uai
//     oia_proce_ve(a) uai
// cabo

// // --- Módulo por zero ---
// // Esperado: [ERRO INTERPRETADOR] Módulo (resto) por zero.
// bora_cumpade main() simbora
//     trem_di_numeru valor, resto uai
//     valor fica_assim_entao 10 uai
//     resto fica_assim_entao valor % 0 uai
// cabo

// // --- Variável usada sem ter sido declarada ---
// // Esperado: [ERRO SEMÂNTICO] Variável 'resultado' usada sem ter sido declarada.
// bora_cumpade main() simbora
//     trem_di_numeru a uai
//     a fica_assim_entao 10 uai
//     resultado fica_assim_entao a + 5 uai
// cabo

// // --- para_o_trem fora de laço ---
// // Esperado: [ERRO SEMÂNTICO] 'para_o_trem' usado fora de um laço.
// bora_cumpade main() simbora
//     trem_di_numeru x uai
//     para_o_trem uai
// cabo

// // --- toca_o_trem fora de laço ---
// // Esperado: [ERRO SEMÂNTICO] 'toca_o_trem' usado fora de um laço.
// bora_cumpade main() simbora
//     trem_di_numeru x uai
//     toca_o_trem uai
// cabo


// =============================================================================
// SEÇÃO 2: ERROS SEMÂNTICOS (TIPOS)
// Detectados pelo Parser antes de chegar na VM.
// =============================================================================

// // --- Atribuição de tipos incompatíveis (string → int) ---
// // Esperado: [ERRO SEMÂNTICO] Tipos incompativeis na atribuição.
// bora_cumpade main() simbora
//     trem_di_numeru x uai
//     trem_discrita s uai
//     s fica_assim_entao "texto" uai
//     x fica_assim_entao s uai
// cabo

// // --- Atribuição de float para int (proibida) ---
// // Esperado: [ERRO SEMÂNTICO] (só int→float é permitido, não float→int)
// bora_cumpade main() simbora
//     trem_di_numeru x uai
//     x fica_assim_entao 3.14 uai
// cabo

// // --- Operação aritmética entre tipos incompatíveis (int + string) ---
// // Esperado: [ERRO SEMÂNTICO] Operacao matematica invalida entre os tipos 'trem_di_numeru' e 'trem_discrita'.
// bora_cumpade main() simbora
//     trem_di_numeru a uai
//     trem_discrita b uai
//     trem_di_numeru c uai
//     a fica_assim_entao 10 uai
//     b fica_assim_entao "ola" uai
//     c fica_assim_entao a + b uai
// cabo

// // --- Operador lógico (tamem) com não-booleanos ---
// // Esperado: [ERRO SEMÂNTICO] A operacao 'tamem' exige dois valores do tipo 'trem_discolhe'.
// bora_cumpade main() simbora
//     trem_di_numeru x, y uai
//     trem_discolhe r uai
//     x fica_assim_entao 1 uai
//     y fica_assim_entao 0 uai
//     r fica_assim_entao x tamem y uai
// cabo

// // --- Divisão inteira (/) com float no operando ---
// // Esperado: [ERRO SEMÂNTICO] A divisão inteira ('/') e o módulo ('%') exigem dois números inteiros.
// bora_cumpade main() simbora
//     trem_cum_virgula a uai
//     trem_di_numeru b, c uai
//     a fica_assim_entao 10.5 uai
//     b fica_assim_entao 2 uai
//     c fica_assim_entao a / b uai
// cabo

// // --- Redeclaração de variável ---
// // Esperado: [ERRO SEMÂNTICO] Variável 'x' já foi declarada anteriormente.
// bora_cumpade main() simbora
//     trem_di_numeru x uai
//     trem_di_numeru x uai
// cabo

// // --- Redeclaração dentro da mesma lista ---
// // Esperado: [ERRO SEMÂNTICO] Variável 'x' já foi declarada anteriormente.
// bora_cumpade main() simbora
//     trem_di_numeru x, x uai
// cabo


