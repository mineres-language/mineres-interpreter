// // --- BUG #10: comparar bool literal com bool computado via '<' crasheia na VM ---
// // Bool literal é a string "eh"/"num_eh". Bool computado (via tamem/relacionais) é
// // Python True/False. Em Python 3, comparar str < bool lança TypeError.
// // Esperado: [ERRO SEMÂNTICO] (comparação < entre booleans deveria ser proibida)
// // Resultado real: [ERRO INTERPRETADOR] Erro de tipo em tempo de execução
// bora_cumpade main() simbora
//     trem_discolhe a, b, c, r uai
//     trem_di_numeru x, y uai
//     a fica_assim_entao eh uai
//     x fica_assim_entao 5 uai
//     y fica_assim_entao 3 uai
//     b fica_assim_entao x > y uai
//     r fica_assim_entao a < b uai
//     oia_proce_ve(r) uai
// cabo

// // --- BUG #11: xove lendo texto em variável int guarda silenciosamente, explode depois ---
// // int("ola") e float("ola") falham, n recebe a string "ola" sem nenhum aviso.
// // Quando n é usado em aritmética, a VM explode com TypeError.
// // (Digite "ola" quando o programa pedir entrada)
// // Esperado: [ERRO INTERPRETADOR] no momento da leitura
// // Resultado real: erro silencioso na leitura; [ERRO INTERPRETADOR] só na soma
// bora_cumpade main() simbora
//     trem_di_numeru n, dobro uai
//     xove(trem_di_numeru, n) uai
//     dobro fica_assim_entao n + n uai
//     oia_proce_ve(dobro) uai
// cabo

// // --- BUG #12: xove lendo float em variável int contamina divisão inteira posterior ---
// // int("3.5") falha, float("3.5") = 3.5 é guardado em variável trem_di_numeru.
